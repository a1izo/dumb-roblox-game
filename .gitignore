# Project place file
/project1.rbxlx

# Roblox Studio lock files
/*.rbxlx.lock
/*.rbxl.lock

sourcemap.json

# Blender
__pycache__/
*.pyc
*.blend1

# Studio importer unpacks embedded textures next to the FBX
art/export/*.fbm/
art/export/scenes/

# Photographed source material (scans, sky panoramas, typefaces): art/sources.json lists every file,
# art/scripts/sources.py fetches them
art/source/

# Fontshare font files (download your own copy from fontshare.com) and UI board screenshots
art/fonts/fontshare/
art/uiboard/

# Preview videos (rendered by art/scripts/video_anims.py) and the downloaded third-party rig
art/export/previews/anims/
art/export/previews/cinema/
art/export/previews/_*.png
art/export/previews/_manual/
art/rig/*.blend
