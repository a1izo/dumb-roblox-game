-- Name matching for the Death Note and the warrant, and the chat/note name filter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NameUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NameUtil"))

return function(t)
	local describe, it, expect = t.describe, t.it, t.expect

	describe("NameUtil.matches", function()
		it("accepts the exact name", function()
			expect(NameUtil.matches("Haruto Kisaragi", "Haruto", "Kisaragi")).to.equal(true)
		end)
		it("ignores capital letters", function()
			expect(NameUtil.matches("haruto KISARAGI", "Haruto", "Kisaragi")).to.equal(true)
		end)
		it("ignores extra spaces", function()
			expect(NameUtil.matches("   Haruto    Kisaragi  ", "Haruto", "Kisaragi")).to.equal(true)
		end)
		it("rejects a typo", function()
			expect(NameUtil.matches("Haruto Kisarogi", "Haruto", "Kisaragi")).to.equal(false)
		end)
		it("rejects a missing space", function()
			expect(NameUtil.matches("HarutoKisaragi", "Haruto", "Kisaragi")).to.equal(false)
		end)
		it("rejects the reversed order", function()
			expect(NameUtil.matches("Kisaragi Haruto", "Haruto", "Kisaragi")).to.equal(false)
		end)
		it("rejects only a first name", function()
			expect(NameUtil.matches("Haruto", "Haruto", "Kisaragi")).to.equal(false)
		end)
	end)

	describe("NameUtil.containsFullName", function()
		it("finds the name inside a sentence", function()
			expect(NameUtil.containsFullName("I think it's Mei Tachibana!", "Mei", "Tachibana")).to.equal(true)
		end)
		it("finds the name without spaces or with punctuation", function()
			expect(NameUtil.containsFullName("mei.tachibana", "Mei", "Tachibana")).to.equal(true)
			expect(NameUtil.containsFullName("MEITACHIBANA", "Mei", "Tachibana")).to.equal(true)
		end)
		it("finds the reversed name order", function()
			expect(NameUtil.containsFullName("Tachibana Mei", "Mei", "Tachibana")).to.equal(true)
		end)
		it("allows single letters and partial names", function()
			expect(NameUtil.containsFullName("M _ I  T _ C H", "Mei", "Tachibana")).to.equal(false)
			expect(NameUtil.containsFullName("her first name is Mei", "Mei", "Tachibana")).to.equal(false)
		end)
	end)

	describe("NameUtil.normalize", function()
		it("lowercases, trims and collapses spaces", function()
			expect(NameUtil.normalize("  Ren \t  ITO ")).to.equal("ren ito")
		end)
	end)
end
