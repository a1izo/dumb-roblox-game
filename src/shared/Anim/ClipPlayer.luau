--!strict
-- Samples the animation clips made in Blender (Clips.luau, generated by
-- art/scripts/export_anims.py). A sample is a CFrame per joint (its rotation, and for joints that
-- also slide their slide, in the joint's parent frame) and an optional whole-body offset in studs.

local Clips = require(script.Parent.Clips)

local ClipPlayer = {}

export type Track = { times: { number }, frames: { CFrame } }
export type Prepared = {
	id: string,
	length: number,
	loop: boolean,
	joints: { [string]: Track },
	offsetTimes: { number }?,
	offsets: { Vector3 }?,
	-- Movement clips: studs the body covers in one cycle, on a rig whose leg (hip to ankle)
	-- is `leg` studs long.
	stride: number?,
	leg: number?,
}

local prepared: { [string]: Prepared } = {}

-- The clip with its keys turned into CFrames (done once per clip), or nil if it does not exist.
function ClipPlayer.get(id: string): Prepared?
	local cached = prepared[id]
	if cached then
		return cached
	end
	local raw = (Clips :: any)[id]
	if not raw then
		return nil
	end
	local joints: { [string]: Track } = {}
	for joint, data in pairs(raw.joints) do
		local frames = {}
		local q = data.q
		local p = data.p -- slides (studs, parent frame), for joints that move as well as turn
		for i = 1, #data.t do
			local base = (i - 1) * 4
			local x, y, z = 0, 0, 0
			if p then
				local at = (i - 1) * 3
				x, y, z = p[at + 1], p[at + 2], p[at + 3]
			end
			frames[i] = CFrame.new(x, y, z, q[base + 1], q[base + 2], q[base + 3], q[base + 4])
		end
		joints[joint] = { times = data.t, frames = frames }
	end
	local clip: Prepared = {
		id = id,
		length = raw.length,
		loop = raw.loop,
		joints = joints,
		stride = raw.stride,
		leg = raw.leg,
	}
	if raw.offset then
		local offsets = {}
		local p = raw.offset.p
		for i = 1, #raw.offset.t do
			local base = (i - 1) * 3
			offsets[i] = Vector3.new(p[base + 1], p[base + 2], p[base + 3])
		end
		clip.offsetTimes = raw.offset.t
		clip.offsets = offsets
	end
	prepared[id] = clip
	return clip
end

function ClipPlayer.exists(id: string): boolean
	return (Clips :: any)[id] ~= nil
end

function ClipPlayer.length(id: string): number
	local clip = ClipPlayer.get(id)
	return if clip then clip.length else 0
end

-- The key index i such that times[i] <= t < times[i + 1] (binary search).
local function find(times: { number }, t: number): number
	local low, high = 1, #times
	if t <= times[1] then
		return 1
	end
	if t >= times[high] then
		return high
	end
	while high - low > 1 do
		local middle = (low + high) // 2
		if times[middle] <= t then
			low = middle
		else
			high = middle
		end
	end
	return low
end

local function localTime(clip: Prepared, time: number): number
	if clip.loop and clip.length > 0 then
		return time % clip.length
	end
	return math.clamp(time, 0, clip.length)
end

function ClipPlayer.sampleTrack(track: Track, t: number): CFrame
	local times = track.times
	local i = find(times, t)
	local j = math.min(i + 1, #times)
	if i == j then
		return track.frames[i]
	end
	local span = times[j] - times[i]
	local alpha = if span > 0 then (t - times[i]) / span else 0
	return track.frames[i]:Lerp(track.frames[j], math.clamp(alpha, 0, 1))
end

function ClipPlayer.sampleOffset(clip: Prepared, t: number): Vector3?
	local times = clip.offsetTimes
	local offsets = clip.offsets
	if not times or not offsets then
		return nil
	end
	local i = find(times, t)
	local j = math.min(i + 1, #times)
	if i == j then
		return offsets[i]
	end
	local span = times[j] - times[i]
	local alpha = if span > 0 then (t - times[i]) / span else 0
	return offsets[i]:Lerp(offsets[j], math.clamp(alpha, 0, 1))
end

-- Every joint's rotation at `time` seconds (looping or holding the end), and the offset.
function ClipPlayer.sample(clip: Prepared, time: number, into: { [string]: CFrame }?): ({ [string]: CFrame }, Vector3?)
	local t = localTime(clip, time)
	local result = into or {}
	for joint, track in pairs(clip.joints) do
		result[joint] = ClipPlayer.sampleTrack(track, t)
	end
	return result, ClipPlayer.sampleOffset(clip, t)
end

-- A joint's sampled CFrame (rotation and slide, parent frame) turned into the joint's Transform for
-- a joint whose C0 has rotation `basis` (so clips work on any rig whose joints are rotated
-- differently): the slide is carried into the C0 frame along with the rotation.
function ClipPlayer.transform(basis: CFrame, rotation: CFrame, offset: Vector3?): CFrame
	local inverse = basis:Inverse()
	local result = inverse * rotation * basis
	if offset then
		result = CFrame.new(inverse * offset) * result
	end
	return result
end

return ClipPlayer
