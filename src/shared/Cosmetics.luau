Cosmetics.RARITY_COLORS = {
	common = Color3.fromRGB(150, 146, 138),
	rare = Color3.fromRGB(62, 139, 255),
	epic = Color3.fromRGB(176, 108, 255),
	legendary = Color3.fromRGB(255, 176, 46),
}

local byId: { [string]: Item } = {}
for _, item in ipairs(Cosmetics.ITEMS) do
	byId[item.id] = item
end

function Cosmetics.byId(id: string?): Item?
	if not id then
		return nil
	end
	return byId[id]
end

-- A suit by id, or nil.
function Cosmetics.suit(id: string): Suit?
	for _, suit in ipairs(Cosmetics.SUITS) do
		if suit.id == id then
			return suit
		end
	end
	return nil
end

-- The suit an item is dealt in (by its kind), or nil.
function Cosmetics.suitOf(item: Item): Suit?
	for _, suit in ipairs(Cosmetics.SUITS) do
		if suit.kinds and table.find(suit.kinds, item.kind) then
			return suit
		end
	end
	return nil
end

function Cosmetics.ofKind(kind: string): { Item }
	local list = {}
	for _, item in ipairs(Cosmetics.ITEMS) do
		if item.kind == kind then
			table.insert(list, item)
		end
	end
	return list
end

-- The emote item for a clip id (its own clip or its other ending, `alt`), or nil (the free emotes have none).
function Cosmetics.emote(clip: string): Item?
	for _, item in ipairs(Cosmetics.ITEMS) do
		if item.kind == "emote" and (item.emote == clip or item.alt == clip) then
			return item
		end
	end
	return nil
end

-- An emote that can be a win scene (played by a winner in "The end", for everyone): not a stroll, not a duo,
-- and nothing that looks like one of a case's signals.
function Cosmetics.winSceneOk(item: Item?): boolean
	return item ~= nil and item.kind == "emote" and not item.stroll and not item.duo and not item.lobbyOnly
end

-- Items that can appear in the daily rotation.
function Cosmetics.rotationPool(): { Item }
	local list = {}
	for _, item in ipairs(Cosmetics.ITEMS) do
		if item.source == "rotation" then
			table.insert(list, item)
		end
	end
	return list
end

return Cosmetics
